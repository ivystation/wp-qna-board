{
  "$comment": "IvyNet 전사 표준 안전장치 — 이 repo에서 Claude Code 작업 시 자동 적용. 파괴적 명령은 차단/되물음, PreToolUse 훅(guard.sh)으로 최종 차단. (출처: ukuhak.com 체계 흡수 — ADR-004)",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(rsync:*)",
      "Bash(git push:*)",
      "Bash(mysql:*)",
      "Bash(wp db:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guard.sh\""
          }
        ]
      }
    ]
  }
}
